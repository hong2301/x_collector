# 复制为 .env 后按本机情况修改；.env 已被 git 忽略
# Chrome 调试端口对应的用户数据目录（登录态）
X_PROFILE_ROOT=C:\Users\jiang\.pi\agent\browser-profile

# 端口 = 账号槽位 映射（端口=profile 目录名）
X_PROFILE_MAP=5268=x1,5269=x2,5270=x3

# 代理，不需要就留空
X_PROXY=http://192.168.31.238:7897

# Chrome 可执行文件
X_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe

# 默认调试端口（主账号）
X_PORT=5268
